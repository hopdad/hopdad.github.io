---
// Decorative live contour map. Place inside a positioned container; add
// `data-topo-host` to the container that should receive pointer movement.
export interface Props {
  seed?: number;
  interactive?: boolean;
  intensity?: number;
  class?: string;
}

const { seed = 7, interactive = false, intensity = 1, class: className } = Astro.props;
---

<canvas
  data-topo
  data-seed={seed}
  data-interactive={interactive ? '' : undefined}
  data-intensity={intensity}
  class:list={['topo-canvas pointer-events-none', className]}
  aria-hidden="true"></canvas>

<script>
  import '@/scripts/topo';
</script>

<style>
  .topo-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
