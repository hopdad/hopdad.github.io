---
import { site } from '@/config';
import { url } from '@/lib/url';
import { getPosts } from '@/lib/blog';
import { pad } from '@/lib/projects';
import LogoMark from './LogoMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import SocialLinks from './SocialLinks.astro';

const posts = await getPosts();
const nav = site.nav.filter((item) => !item.requiresPosts || posts.length > 0);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  !href.includes('#') && (path === href || path.startsWith(`${href}/`));
---

<header
  id="site-header"
  class="site-header fixed inset-x-0 top-0 z-50"
  data-scrolled="false"
  data-hidden="false"
  data-menu-open="false"
>
  <div class="container-wide flex h-[4.5rem] items-center justify-between gap-6">
    <a href={url('/')} class="group flex items-center gap-3 text-ink">
      <LogoMark
        class="h-8 w-8 transition-transform duration-700 ease-out-expo group-hover:rotate-[24deg]"
      />
      <span class="font-display text-[1.125rem] font-semibold tracking-tight">{site.name}</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <nav aria-label="Primary" class="mr-5 hidden items-center gap-8 md:flex">
        {
          nav.map((item) => (
            <a
              href={url(item.href)}
              class="link-underline py-1 text-sm font-medium"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-line text-ink transition-colors hover:border-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only" data-menu-label>Menu</span>
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu md:hidden" data-open="false">
  <nav aria-label="Mobile" class="container-wide flex flex-1 flex-col justify-center">
    <ol>
      {
        [{ href: '/', label: 'Home' }, ...nav].map((item, i) => (
          <li class="menu-item" style={`--i: ${i}`}>
            <a
              href={url(item.href)}
              class="flex items-baseline gap-4 py-3 font-display text-[2.75rem] leading-none tracking-tight"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              <span class="font-mono text-xs text-accent-ink">{pad(i + 1)}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="container-wide flex items-center justify-between gap-4 border-t border-line py-6">
    <p class="mono-label leading-relaxed">{site.title}<br />Based in {site.location}</p>
    <SocialLinks />
  </div>
</div>

<script>
  const header = document.getElementById('site-header')!;
  const menu = document.getElementById('mobile-menu')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const label = toggle.querySelector('[data-menu-label]')!;

  // Frosted once scrolled; tucks away on scroll-down and returns on scroll-up.
  let lastY = window.scrollY;
  let queued = false;
  const onScroll = () => {
    queued = false;
    const y = window.scrollY;
    header.dataset.scrolled = String(y > 12);
    const delta = y - lastY;
    if (Math.abs(delta) < 8) return;
    header.dataset.hidden = String(delta > 0 && y > 480 && header.dataset.menuOpen !== 'true');
    lastY = y;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(onScroll);
      }
    },
    { passive: true }
  );
  requestAnimationFrame(onScroll);

  const setMenu = (open: boolean) => {
    header.dataset.menuOpen = String(open);
    menu.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Close menu' : 'Menu';
    document.documentElement.style.overflow = open ? 'hidden' : '';
    for (const id of ['main', 'site-footer']) {
      const el = document.getElementById(id);
      if (el) el.inert = open;
    }
    if (open) {
      header.dataset.hidden = 'false';
      menu.querySelector('a')?.focus();
    }
  };

  toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.dataset.menuOpen === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });
</script>

<style>
  .site-header {
    view-transition-name: site-header;
    border-bottom: 1px solid transparent;
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.3s ease,
      border-color 0.3s ease;
  }
  .site-header[data-scrolled='true'],
  .site-header[data-menu-open='true'] {
    background-color: rgb(var(--page) / 0.82);
    border-bottom-color: rgb(var(--line) / 0.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
  }
  .site-header[data-hidden='true']:not(:focus-within) {
    transform: translate3d(0, -100%, 0);
  }

  .menu-icon {
    position: relative;
    display: block;
    width: 18px;
    height: 10px;
  }
  .menu-icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 0.45s var(--ease-out),
      top 0.45s var(--ease-out);
  }
  .menu-icon span:first-child {
    top: 0;
  }
  .menu-icon span:last-child {
    top: 8.5px;
  }
  [aria-expanded='true'] .menu-icon span:first-child {
    top: 4.25px;
    transform: rotate(45deg);
  }
  [aria-expanded='true'] .menu-icon span:last-child {
    top: 4.25px;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    padding-top: 4.5rem;
    background: rgb(var(--page));
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s var(--ease-out),
      visibility 0s linear 0.35s;
  }
  .mobile-menu[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s var(--ease-out);
  }
  .menu-item {
    opacity: 0;
    transform: translate3d(0, 1rem, 0);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i) * 60ms + 80ms);
  }
  .mobile-menu[data-open='true'] .menu-item {
    opacity: 1;
    transform: none;
  }
  .menu-item a[aria-current='page'] {
    color: rgb(var(--accent-ink));
  }
</style>
