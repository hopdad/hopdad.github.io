---
import { Image } from 'astro:assets';
import StatValue from './StatValue.astro';
import { categoryLabel, pad, type Project } from '@/lib/projects';
import { url } from '@/lib/url';

export interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ol class="showcase">
  {
    projects.map((project, i) => {
      const { title, description, thumbnail, thumbnailAlt, stats, category, completedDate } =
        project.data;
      return (
        <li class="showcase-item" style={`--i: ${i}`} data-stack-item>
          <article class="showcase-card group">
            <div class="flex flex-col gap-6 p-6 sm:p-8 lg:p-10">
              <div class="mono-label flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
                <span class="whitespace-nowrap">
                  <span class="text-accent-ink">{pad(i + 1)}</span> / {pad(projects.length)}
                </span>
                <span class="whitespace-nowrap">
                  {categoryLabel[category]} · {completedDate.getUTCFullYear()}
                </span>
              </div>
              <h3 class="font-display text-display-lg font-medium [font-variation-settings:'opsz'_144] lg:mt-auto">
                <a href={url(`/projects/${project.slug}`)} class="card-link">
                  {title}
                </a>
              </h3>
              <p class="max-w-md text-muted">{description}</p>
              {stats.length > 0 && (
                <ul class="grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-6 sm:grid-cols-3">
                  {stats.slice(0, 3).map((stat) => (
                    <li>
                      <p class="font-display text-[2rem] font-medium leading-none">
                        <StatValue value={stat.value} />
                      </p>
                      <p class="mt-2 text-[0.8125rem] leading-snug text-muted">{stat.label}</p>
                    </li>
                  ))}
                </ul>
              )}
              <span
                class="inline-flex items-center gap-2 text-sm font-semibold text-accent-ink"
                aria-hidden="true"
              >
                Read the case study
                <svg
                  class="h-4 w-4 transition-transform duration-500 ease-out-expo group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M13 5l7 7-7 7" />
                </svg>
              </span>
            </div>
            <div class="showcase-art" style={`view-transition-name: art-${project.slug}`}>
              <Image
                src={thumbnail}
                alt={thumbnailAlt}
                widths={[600, 900, 1200]}
                sizes="(min-width: 1024px) 700px, 100vw"
                class="h-full w-full object-cover transition-transform duration-[1.2s] ease-out-expo group-hover:scale-[1.04]"
              />
            </div>
          </article>
        </li>
      );
    })
  }
</ol>

<script>
  // Desktop: cards stick and stack; each one recedes as the next slides over it.
  const items = [...document.querySelectorAll<HTMLElement>('[data-stack-item]')];
  const stacking = window.matchMedia('(min-width: 1024px) and (min-height: 640px)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  let queued = false;

  const update = () => {
    queued = false;
    const active = stacking.matches && !reduce.matches;
    for (let k = 0; k < items.length; k++) {
      const next = items[k + 1];
      if (!active || !next) {
        items[k].style.removeProperty('--cover');
        continue;
      }
      const card = items[k].getBoundingClientRect();
      const covered = 1 - (next.getBoundingClientRect().top - card.top) / card.height;
      items[k].style.setProperty('--cover', Math.min(1, Math.max(0, covered)).toFixed(3));
    }
  };
  const schedule = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(update);
    }
  };

  if (items.length) {
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    stacking.addEventListener('change', schedule);
    schedule();
  }
</script>

<style>
  .showcase {
    display: grid;
    gap: 1.5rem;
  }

  .showcase-card {
    position: relative;
    display: grid;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgb(var(--line));
    background: rgb(var(--surface));
    transform-origin: 50% 0;
    transition: border-color 0.4s ease;
  }
  .showcase-card:hover {
    border-color: rgb(var(--accent) / 0.6);
  }
  .showcase-card:focus-within {
    outline: 2px solid rgb(var(--accent-ink));
    outline-offset: 4px;
  }
  .showcase-card:focus-within .card-link:focus-visible {
    outline: none;
  }

  /* The title link covers the whole card. */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .showcase-art {
    order: -1;
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: rgb(var(--page-alt));
  }

  @media (min-width: 1024px) {
    .showcase-card {
      grid-template-columns: 5fr 7fr;
      min-height: min(36rem, calc(100vh - 11rem));
    }
    .showcase-art {
      order: 0;
      aspect-ratio: auto;
      border-left: 1px solid rgb(var(--line));
    }
  }

  @media (min-width: 1024px) and (min-height: 640px) {
    .showcase {
      gap: 14vh;
    }
    .showcase-item {
      position: sticky;
      top: calc(5.5rem + var(--i) * 1.25rem);
    }
    .showcase-card {
      transform: scale(calc(1 - var(--cover, 0) * 0.05));
      box-shadow: 0 -1.5rem 3rem -1.75rem rgb(10 25 34 / 0.45);
    }
    /* Dim a card as the next one covers it. */
    .showcase-card::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 3;
      pointer-events: none;
      background: rgb(var(--page-alt));
      opacity: calc(var(--cover, 0) * 0.6);
    }
  }
</style>
