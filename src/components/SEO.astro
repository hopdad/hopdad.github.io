---
import { site } from '@/config';

const DEFAULT_IMAGE = '/og-default.png';

export interface Props {
  title?: string;
  description?: string;
  /** A public path, or an imported image (e.g. a project's share card). */
  image?: string | ImageMetadata;
  imageAlt?: string;
  canonical?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search results (and skip its canonical). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = DEFAULT_IMAGE,
  imageAlt: imageAltProp,
  canonical,
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} (${site.alias}) — ${site.title}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const imageSrc = typeof image === 'string' ? image : image.src;
const ogImage = new URL(imageSrc, Astro.site).toString();
const isDefaultImage = imageSrc === DEFAULT_IMAGE;
const imageSize =
  typeof image !== 'string'
    ? { width: image.width, height: image.height }
    : isDefaultImage
      ? { width: 1200, height: 630 }
      : undefined;
const imageAlt =
  imageAltProp ??
  (isDefaultImage
    ? `${site.name}: “Some problems need Python. Others need a torque wrench.” over a topographic map.`
    : pageTitle);
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
{
  site.googleSiteVerification && (
    <meta name="google-site-verification" content={site.googleSiteVerification} />
  )
}

<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
{imageSize && <meta property="og:image:width" content={String(imageSize.width)} />}
{imageSize && <meta property="og:image:height" content={String(imageSize.height)} />}
<meta property="og:site_name" content={site.name} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
