---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Marquee from '@/components/Marquee.astro';
import Stats from '@/components/Stats.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ProjectShowcase from '@/components/ProjectShowcase.astro';
import Process from '@/components/Process.astro';
import About from '@/components/About.astro';
import Contact from '@/components/Contact.astro';
import { site } from '@/config';
import { getProjects } from '@/lib/projects';
import { url } from '@/lib/url';

const featured = await getProjects(({ data }) => data.featured);
const total = (await getProjects()).length;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  email: `mailto:${site.email}`,
  url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', addressRegion: 'MI', addressCountry: 'US' },
  sameAs: [site.social.github, site.social.linkedin].filter(Boolean),
};
---

<BaseLayout jsonLd={personJsonLd}>
  <Hero />
  <Marquee />
  <Stats />

  <section id="work" aria-labelledby="work-title" class="pb-section md:pb-section-lg">
    <div class="container-wide">
      <SectionHeader eyebrow="01 — Selected work" id="work-title">
        <Fragment slot="title">Built, tested, <em>put to work.</em></Fragment>
        Machine learning, electrical systems, engines, and the processes that keep a distribution center
        moving — each one started with a problem worth solving.
      </SectionHeader>
      <div class="mt-14 md:mt-20">
        <ProjectShowcase projects={featured} />
      </div>
      {
        total > featured.length && (
          <div class="mt-12 flex justify-center">
            <a href={url('/projects')} class="btn btn-ghost">
              See all {total} projects
            </a>
          </div>
        )
      }
    </div>
  </section>

  <Process />
  <About />
  <Contact />
</BaseLayout>
