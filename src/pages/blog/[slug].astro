---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts } from '@/lib/blog';
import { url } from '@/lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, pubDate, updatedDate, tags } = post.data;
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<BaseLayout title={title} description={description} type="article">
  <article class="container-wide pb-section pt-32 md:pb-section-lg md:pt-40">
    <a href={url('/blog')} class="mono-label link-underline text-ink">← All notes</a>

    <header class="mt-10 max-w-4xl">
      <p class="eyebrow">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span>· Updated {formatDate(updatedDate)}</span>}
      </p>
      <h1
        class="mt-6 font-display text-display-xl font-medium [font-variation-settings:'opsz'_144]"
      >
        {title}
      </h1>
      <p class="mt-6 text-body-lg text-muted">{description}</p>
      {
        tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="chip">#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose-site mt-14 max-w-prose text-body-lg">
      <Content />
    </div>
  </article>
</BaseLayout>
