---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatValue from '@/components/StatValue.astro';
import { categoryLabel, getProjects, pad, timingDetail, type Project } from '@/lib/projects';
import { site } from '@/config';
import { url } from '@/lib/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      index,
      total: projects.length,
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  index: number;
  total: number;
  next: Project;
}

const { project, index, total, next } = Astro.props;
const { Content, headings } = await project.render();
const sections = headings.filter((heading) => heading.depth === 2);
const {
  title,
  description,
  thumbnail,
  thumbnailAlt,
  techStack,
  stats,
  liveUrl,
  githubUrl,
  completedDate,
  category,
  status,
} = project.data;

const timing = timingDetail(project);

// Share cards from scripts/og-cards.mjs; pages without one use the default image.
const shareCards = import.meta.glob<{ default: ImageMetadata }>('/src/assets/og/*.jpg', {
  eager: true,
});
const shareCard = shareCards[`/src/assets/og/${project.slug}.jpg`]?.default;
const home = new URL(url('/'), Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  [status === 'complete' ? 'dateCreated' : 'dateModified']: completedDate.toISOString(),
  genre: categoryLabel[category],
  keywords: techStack.join(', '),
  url: Astro.url.toString(),
  author: {
    '@type': 'Person',
    '@id': `${home}#person`,
    name: site.name,
    alternateName: site.alias,
    url: home,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  image={shareCard}
  imageAlt={shareCard && `${title}, by ${site.name}: ${project.data.thumbnailAlt}`}
  type="article"
  jsonLd={jsonLd}
>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <article>
    <header class="container-wide pt-32 md:pt-40">
      <a href={url('/projects')} class="mono-label link-underline fade-up text-ink">← All work</a>
      <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="eyebrow fade-up" style="--rise-delay: 60">
            {pad(index + 1)} / {pad(total)} — {categoryLabel[category]}
          </p>
          <h1
            class="mt-6 font-display text-display-xl font-medium [font-variation-settings:'opsz'_144]"
          >
            <span class="clip-line"
              ><span class="rise" style="--rise-delay: 120">{title}</span></span
            >
          </h1>
        </div>
        <div class="fade-up lg:col-span-4" style="--rise-delay: 300">
          <p class="text-body-lg text-muted">{description}</p>
          {
            (liveUrl || githubUrl) && (
              <div class="mt-6 flex flex-wrap gap-3">
                {liveUrl && (
                  <a
                    href={liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary"
                  >
                    Live demo <span aria-hidden="true">↗</span>
                  </a>
                )}
                {githubUrl && (
                  <a
                    href={githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-ghost"
                  >
                    View on GitHub <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            )
          }
        </div>
      </div>
    </header>

    <figure class="container-wide fade-up mt-12 md:mt-16" style="--rise-delay: 420">
      <div
        class="overflow-hidden rounded-[14px] border border-line"
        style={`view-transition-name: art-${project.slug}`}
      >
        <Image
          src={thumbnail}
          alt={thumbnailAlt}
          widths={[800, 1200, 1600]}
          sizes="(min-width: 1280px) 1184px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full"
        />
      </div>
    </figure>

    <section class="container-wide mt-10" aria-label="Project details">
      <dl
        class="grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-4"
      >
        <div class="bg-page p-6">
          <dt class="mono-label">Discipline</dt>
          <dd class="mt-2 font-display text-heading-md">{categoryLabel[category]}</dd>
        </div>
        <div class="bg-page p-6">
          <dt class="mono-label">{timing.label}</dt>
          {
            timing.note ? (
              <>
                <dd class="mt-2 font-display text-heading-md">{timing.value}</dd>
                <dd class="mt-1 text-sm text-muted">
                  <time datetime={completedDate.toISOString()}>{timing.note}</time>
                </dd>
              </>
            ) : (
              <dd class="mt-2 font-display text-heading-md">
                <time datetime={completedDate.toISOString()}>{timing.value}</time>
              </dd>
            )
          }
        </div>
        <div class="bg-page p-6 sm:col-span-2">
          <dt class="mono-label">Toolkit</dt>
          <dd class="mt-3">
            <ul class="flex flex-wrap gap-2">
              {techStack.map((tool) => <li class="chip">{tool}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
    </section>

    {
      stats.length > 0 && (
        <section class="container-wide mt-16" aria-label="Results">
          <ul class="project-stats grid border-t border-line sm:grid-cols-3">
            {stats.map((stat, i) => (
              <li data-reveal style={`--reveal-delay: ${i * 90}`}>
                <p class="font-display text-[clamp(2.75rem,5.5vw,4.5rem)] font-medium leading-none tracking-tight [font-variation-settings:'opsz'_144]">
                  <StatValue value={stat.value} />
                </p>
                <p class="mt-3 max-w-[18rem] text-sm leading-relaxed text-muted">{stat.label}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="container-wide mt-16 grid gap-12 md:mt-24 lg:grid-cols-12">
      {
        sections.length > 1 && (
          <aside class="hidden lg:col-span-3 lg:block">
            <nav aria-label="On this page" class="sticky top-28">
              <p class="mono-label">On this page</p>
              <ol class="mt-5 space-y-1 border-l border-line">
                {sections.map((heading, i) => (
                  <li>
                    <a href={`#${heading.slug}`} class="toc-link" data-toc={heading.slug}>
                      <span class="font-mono text-[0.6875rem]">{pad(i + 1)}</span>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
      <div class="prose-site max-w-prose text-body-lg lg:col-span-8 lg:col-start-5">
        <Content />
      </div>
    </div>

    <nav aria-label="Next project" class="container-wide mt-section md:mt-section-lg">
      <a
        href={url(`/projects/${next.slug}`)}
        class="next-link group block border-t border-line pb-16 pt-12 md:pb-24 md:pt-16"
      >
        <span class="mono-label">Next project</span>
        <span
          class="mt-4 flex items-end justify-between gap-6 font-display text-display-xl font-medium [font-variation-settings:'opsz'_144]"
        >
          <span class="next-title">{next.data.title}</span>
          <svg
            class="next-arrow mb-2 h-10 w-10 shrink-0 md:h-14 md:w-14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </span>
      </a>
    </nav>
  </article>
</BaseLayout>

<script>
  // Reading progress bar.
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  if (bar) {
    let queued = false;
    const update = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();
  }

  // Highlight the section being read in the table of contents.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc, a])
  );
  if (links.size && 'IntersectionObserver' in window) {
    const setActive = (id: string) =>
      links.forEach((link, key) =>
        key === id
          ? link.setAttribute('aria-current', 'true')
          : link.removeAttribute('aria-current')
      );
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: '0px 0px -70% 0px' }
    );
    links.forEach((_, id) => {
      const heading = document.getElementById(id!);
      if (heading) io.observe(heading);
    });
  }
</script>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 2px;
    pointer-events: none;
  }
  .progress span {
    display: block;
    height: 100%;
    background: rgb(var(--accent));
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .project-stats > li {
    padding: 1.75rem 0;
    border-bottom: 1px solid rgb(var(--line));
  }
  @media (min-width: 640px) {
    .project-stats > li {
      padding: 2.25rem 1.5rem 2.25rem 0;
      border-bottom: 0;
    }
    .project-stats > li + li {
      padding-left: 1.5rem;
      border-left: 1px solid rgb(var(--line));
    }
  }

  .toc-link {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    margin-left: -1px;
    padding: 0.35rem 0 0.35rem 1rem;
    border-left: 1px solid transparent;
    color: rgb(var(--muted));
    transition:
      color 0.3s ease,
      border-color 0.3s ease;
  }
  .toc-link:hover,
  .toc-link[aria-current] {
    color: rgb(var(--ink));
  }
  .toc-link[aria-current] {
    border-left-color: rgb(var(--accent));
  }
  .toc-link[aria-current] span {
    color: rgb(var(--accent-ink));
  }

  .next-title {
    transition: color 0.4s ease;
  }
  .next-arrow {
    transition: transform 0.6s var(--ease-out);
  }
  .next-link:hover .next-title {
    color: rgb(var(--accent-display));
  }
  .next-link:hover .next-arrow {
    transform: translateX(0.5rem);
  }
</style>
